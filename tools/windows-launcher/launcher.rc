#include <winver.h>

#ifndef APP_VER_NUM
#define APP_VER_NUM 0,1,0,0
#endif

#ifndef APP_VER_STR
#define APP_VER_STR "0.1.0.0"
#endif

#ifndef APP_ICON_PATH
#define APP_ICON_PATH "../../art-source/brand/icons/WestwardWatch.ico"
#endif

1 ICON APP_ICON_PATH
1 24 "launcher.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION APP_VER_NUM
 PRODUCTVERSION APP_VER_NUM
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Outsider Studio"
            VALUE "FileDescription", "Westward Watch"
            VALUE "FileVersion", APP_VER_STR
            VALUE "InternalName", "WestwardWatch"
            VALUE "LegalCopyright", "Copyright (C) 2026 Outsider Studio (Apache-2.0)"
            VALUE "OriginalFilename", "WestwardWatch.exe"
            VALUE "ProductName", "Westward Watch"
            VALUE "ProductVersion", APP_VER_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
